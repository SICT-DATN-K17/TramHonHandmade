<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_tramhon" model="ir.ui.view">
        <field name="name">product.template.form.inherit.tramhon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='group_general']" position="replace">
                <group name="group_general">
                    <field name="active" invisible="1"/>
                    <field name="detailed_type" invisible="1"/>
                    <field name="invoice_policy" invisible="1"/>
                    <field name="uom_id" invisible="1"/>
                    <field name="uom_po_id" invisible="1"/>

                    <field name="x_django_id" readonly="1"/>
                    <field name="x_artisan_id" options="{'no_create': True}"/>
                    <field name="x_image_url" widget="url"/>
                    <field name="x_web_status" decoration-success="x_web_status == 'ACTIVE'" decoration-danger="x_web_status == 'HIDDEN'"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='taxes_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="description_sale" placeholder="Nhập mô tả chi tiết sản phẩm hiển thị trên web..."/>
            </xpath>

            <xpath expr="//page[@name='sales']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='purchase']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='inventory']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='invoicing']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="product_template_tree_view_inherit_tramhon" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.tramhon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="x_web_status" optional="show" decoration-success="x_web_status == 'ACTIVE'" decoration-danger="x_web_status == 'HIDDEN'"/>
            </xpath>
        </field>
    </record>
    <record id="product_normal_form_view_inherit_tramhon" model="ir.ui.view">
        <field name="name">product.product.form.inherit.tramhon</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='group_general']" position="replace">
                <group name="group_general">
                    <field name="active" invisible="1"/>
                    <field name="detailed_type" invisible="1"/>
                    <field name="invoice_policy" invisible="1"/>
                    <field name="uom_id" invisible="1"/>
                    <field name="uom_po_id" invisible="1"/>

                    <field name="x_django_id" readonly="1"/>
                    <field name="x_artisan_id" options="{'no_create': True}"/>
                    <field name="x_image_url"/>
                    <field name="x_description"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='image_1920']" position="replace">
                <field name="x_image_url" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
            </xpath>
            
        </field>
    </record>

    <record id="product_product_tree_view_inherit_tramhon" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.tramhon</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="x_web_status" optional="show" decoration-success="x_web_status == 'ACTIVE'" decoration-danger="x_web_status == 'HIDDEN'"/>
            </xpath>
        </field>
    </record>


    <record id="sale.product_template_action" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,activity</field>
    </record>

    <record id="product.product_template_action" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <record id="stock.product_template_action_product" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <menuitem id="menu_product_root_custom" name="Sản phẩm" sequence="5" web_icon="product,static/description/icon.png"/>

    <menuitem id="menu_product_list_custom" name="Sản phẩm" parent="menu_product_root_custom" action="stock.product_template_action_product" sequence="10"/>

    <menuitem id="menu_product_category_custom" name="Danh mục sản phẩm" parent="menu_product_root_custom" action="product.product_category_action_form" sequence="20"/>

    <record id="stock.menu_product_variant_config_stock" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>