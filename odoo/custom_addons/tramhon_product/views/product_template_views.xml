<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_tramhon" model="ir.ui.view">
        <field name="name">product.template.form.inherit.tramhon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="x_artisan_id" options="{'no_create': True}"/> <field name="x_django_id" readonly="1"/>
            </xpath>

            <xpath expr="//page[@name='sales']" position="after">
                <page string="Trạm Hồn Media">
                    <group>
                        <field name="x_image_url" widget="url"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
    
    <record id="product_template_tree_view_inherit_tramhon" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.tramhon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="x_artisan_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>