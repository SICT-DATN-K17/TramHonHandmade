<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_tramhon" model="ir.ui.view">
        <field name="name">product.template.form.inherit.tramhon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="x_artisan_id" options="{'no_create': True}"/>
                <field name="x_django_id" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='optional_product_ids']" position="after">
                <field name="x_image_url" widget="url"/>
            </xpath>

        </field>
    </record>

    <record id="product_template_tree_view_inherit_tramhon" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.tramhon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="x_artisan_id" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="sale.product_template_action" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,activity</field>
    </record>

    <record id="product.product_template_action" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <record id="stock.product_template_action_product" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <menuitem id="menu_product_root_custom" name="Sản phẩm" action="stock.product_template_action_product" sequence="5" web_icon="product,static/description/icon.png"/>
    <record id="stock.menu_product_variant_config_stock" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>