<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_tramhon" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tramhon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_artisan_id" options="{'no_create': True}"/>
                <field name="x_django_id" readonly="1"/>
            </xpath>

            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Thông tin từ Web Trạm Hồn">
                    <field name="x_web_status"/>
                    <field name="x_payment_method"/>
                    <field name="x_web_phone"/>
                    <field name="x_web_address"/>
                    <field name="x_web_note"/>
                </group>
            </xpath>

        </field>
    </record>

    <record id="view_quotation_tree_inherit_tramhon" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.tramhon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_artisan_id" optional="show"/>
                <field name="x_web_status" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_inherit_tramhon_status" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tramhon.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <field name="x_web_status" widget="statusbar" statusbar_visible="PENDING_PICKUP,PACKAGING,SHIPPING,DELIVERED,COMPLETED"/>
            </xpath>

        </field>
    </record>
    <record id="view_order_tree_inherit_tramhon" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.tramhon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_django_id"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="x_web_status" string="Trạng thái Web" widget="badge" decoration-warning="x_web_status == 'PENDING_PICKUP'" decoration-info="x_web_status in ('PACKAGING', 'SHIPPING')" decoration-success="x_web_status in ('DELIVERED', 'COMPLETED')" decoration-danger="x_web_status == 'CANCELLED'" decoration-muted="x_web_status == 'REFUNDED'" optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>