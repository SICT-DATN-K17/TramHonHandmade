<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_tramhon" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tramhon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_admin_delivered" type="object" string="Đã giao hàng" class="oe_highlight" attrs="{'invisible': [('x_web_status', '!=', 'SHIPPING')]}"/>
                <field name="x_web_status" widget="statusbar" statusbar_visible="PENDING_PICKUP,PACKAGING,SHIPPING,DELIVERED,COMPLETED"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_web_phone"/>
                <field name="x_artisan_id" options="{'no_create': True}"/>
                <field name="x_django_id" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="x_payment_method"/>
                <field name="x_web_address"/>
                <field name="x_web_note"/>
            </xpath>

            <xpath expr="//page[@name='other_information']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='customer_signature']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_quotation_tree_inherit_tramhon" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.tramhon.quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_artisan_id" optional="show"/>
                <field name="x_web_status" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_tramhon" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.tramhon.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_django_id"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="x_web_status" string="Trạng thái Web" widget="badge" decoration-warning="x_web_status == 'PENDING_PICKUP'" decoration-info="x_web_status == 'PACKAGING'" decoration-primary="x_web_status == 'SHIPPING'" decoration-bf="x_web_status == 'DELIVERED_AWAITING'" decoration-success="x_web_status in ('DELIVERED', 'COMPLETED')" decoration-danger="x_web_status == 'CANCELLED'" decoration-muted="x_web_status == 'REFUNDED'" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>